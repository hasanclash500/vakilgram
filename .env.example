DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

SITE_URL="https://example.com"
PRIVACY_CONTACT_EMAIL="privacy@example.com"

FEATURE_VOICE="true"
NEXT_PUBLIC_FEATURE_VOICE="true"

# Feature flags فاز ۲
FEATURE_WALLET="true"
FEATURE_REVIEWS="true"
FEATURE_CHAT="true"
# زمان‌بندی خودکار همچنان فاز ۳ است.
FEATURE_AUTO_UPDATE="false"
LEGAL_DISCLAIMER="این پاسخ صرفاً اطلاعات عمومی حقوقی است و جایگزین مشاوره رسمی وکیل نیست."

# برای HMAC شناسه مرورگر؛ مقدار بلند و تصادفی
VISITOR_HASH_SECRET="replace-with-a-long-random-secret"
# سازگاری با تنظیمات قدیمی؛ در صورت وجود VISITOR_HASH_SECRET لازم نیست.
CLICK_HASH_SECRET=""

# محدودیت پیش‌فرض: ۲۰ پرسش در ۱۰ دقیقه
LEGAL_ASK_RATE_LIMIT="20"
LEGAL_ASK_RATE_WINDOW_SECONDS="600"

OPENROUTER_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
CLOUDFLARE_AI_API_KEY=""
MISTRAL_API_KEY=""
TOGETHER_API_KEY=""
FIREWORKS_API_KEY=""
DEEPSEEK_API_KEY=""

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="false"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_RESEND_KEY=""
EMAIL_FROM="noreply@example.com"

# ایمیل‌هایی که پس از ورود نقش ADMIN می‌گیرند (جداشده با کاما)
ADMIN_EMAILS="admin@example.com"

# 2FA ادمین - فعال در فاز ۲
# هر دو مقدار Production باید بلند و تصادفی باشند.
# ADMIN_2FA_ENCRYPTION_KEY باید دقیقاً 32 بایت Base64 decode شود.
# نمونه تولید محلی: openssl rand -base64 32
ADMIN_2FA_ENCRYPTION_KEY=""
# نمونه تولید محلی: openssl rand -base64 48
ADMIN_2FA_COOKIE_SECRET=""
